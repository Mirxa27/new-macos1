# Database
DATABASE_URL="postgresql://username:password@localhost:5432/voiceagent?schema=public"
POSTGRES_URL="postgresql://username:password@localhost:5432/voiceagent"

# NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider API Keys
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GOOGLE_API_KEY="your-google-api-key"
GROQ_API_KEY="your-groq-api-key"

# Encryption Key for storing API keys
ENCRYPTION_KEY="your-32-character-encryption-key"

# File Upload
UPLOAD_PATH="/tmp/uploads"
MAX_FILE_SIZE="10485760"

# Email Service (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# App Configuration
APP_NAME="Voice Agent Pro"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@voiceagent.com"
